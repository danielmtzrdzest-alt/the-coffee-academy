# Proyecto Supabase COMPARTIDO con the-coffee-cash
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server-side (nunca con prefijo NEXT_PUBLIC). Usado por el script de import
# y por las server actions que omiten RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de Storage para podcasts
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=podcasts
# URL pública del sitio (para enlaces de acceso generados en el panel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
